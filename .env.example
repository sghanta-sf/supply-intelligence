# Copy to .env (gitignored) and fill in local credentials.
# Switch Lakebase with LAKEBASE_BRANCH only — endpoint and CDF paths are derived.

DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
LAKEBASE_DATABASE_CLIENT_SECRET=

# Dedicated substitution-agent service principal. Must differ from DATABRICKS_CLIENT_ID.
# The app SP creates sim-* branches; this SP is the only identity that reads/writes on them.
LAKEBASE_AGENT_CLIENT_ID=
LAKEBASE_AGENT_CLIENT_SECRET=

# Optional CLI profile when not using M2M / DATABRICKS_HOST
DATABRICKS_PROFILE=

LAKEBASE_PROJECT=supply-intelligence
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_BRANCH=production

# SQL warehouse ID and Unity Catalog for lakehouse lookups
DATABRICKS_WAREHOUSE_ID=
LAKEHOUSE_CATALOG=
LAKEHOUSE_CDF_SCHEMA=decision-history

# Comma-separated emails for the Platform Administration tab
PLATFORM_ADMIN_EMAILS=
DEFAULT_IDENTITY_EMAIL=admin@apexhealth.org
DEFAULT_IDENTITY_NAME=Materials Director
